page {
  min-height: 100%;
  background: #f6f7fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.panel {
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muted {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.7;
}
