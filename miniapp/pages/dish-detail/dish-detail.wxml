<view class="page">
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{errorMessage}}" class="state error">
    <text>{{errorMessage}}</text>
    <view wx:if="{{id}}" class="retry" bindtap="reload">重试</view>
  </view>

  <view wx:if="{{dish}}" class="detail">
    <image wx:if="{{dish.hasImage}}" class="cover" src="{{dish.imageUrl}}" mode="aspectFill" />
    <view wx:else class="cover placeholder">{{dish.categoryLabel}}</view>

    <view class="panel main-panel">
      <view class="title-line">
        <text class="dish-name">{{dish.name}}</text>
        <text class="status {{dish.available ? '' : 'danger'}}">{{dish.statusLabel}}</text>
      </view>
      <text class="description">{{dish.description}}</text>
      <view class="price-line">
        <text class="price">{{dish.priceText}}</text>
        <text wx:if="{{dish.originalPriceText}}" class="original-price">{{dish.originalPriceText}}</text>
      </view>
      <view class="tags">
        <text class="tag">{{dish.categoryLabel}}</text>
        <text wx:for="{{dish.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
    </view>

    <view class="panel">
      <text class="section-title">窗口信息</text>
      <view class="info-row">
        <text class="label">食堂</text>
        <text>{{dish.canteenName}}</text>
      </view>
      <view class="info-row">
        <text class="label">窗口</text>
        <text>{{dish.windowName}}</text>
      </view>
      <view class="info-row" wx:if="{{dish.windowLocation}}">
        <text class="label">位置</text>
        <text>{{dish.windowLocation}}</text>
      </view>
      <view class="info-row">
        <text class="label">库存</text>
        <text>{{dish.stockText}}</text>
      </view>
    </view>

    <view class="panel">
      <text class="section-title">评价与热度</text>
      <view class="metric-grid">
        <view class="metric">
          <text class="metric-value">{{dish.ratingText}}</text>
          <text class="muted">评分</text>
        </view>
        <view class="metric">
          <text class="metric-value">{{dish.ratingCount}}</text>
          <text class="muted">评价数</text>
        </view>
        <view class="metric">
          <text class="metric-value">{{dish.salesCount}}</text>
          <text class="muted">销量</text>
        </view>
      </view>
    </view>

    <view class="panel">
      <text class="section-title">营养信息</text>
      <view class="nutrition-grid">
        <view class="nutrition">
          <text class="metric-value">{{dish.caloriesText}}</text>
          <text class="muted">热量</text>
        </view>
        <view class="nutrition">
          <text class="metric-value">{{dish.proteinText}}</text>
          <text class="muted">蛋白质</text>
        </view>
        <view class="nutrition">
          <text class="metric-value">{{dish.fatText}}</text>
          <text class="muted">脂肪</text>
        </view>
        <view class="nutrition">
          <text class="metric-value">{{dish.carbohydrateText}}</text>
          <text class="muted">碳水</text>
        </view>
      </view>
    </view>
  </view>
</view>
