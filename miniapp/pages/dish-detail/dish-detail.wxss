.detail-page {
  padding-bottom: 150rpx;
}

.state {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b45309;
}

.retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  padding: 12rpx 22rpx;
  border-radius: 10rpx;
  background: #0f766e;
  color: #ffffff;
}

.cover {
  width: 100%;
  height: 390rpx;
  border-radius: 14rpx;
  background: #eef2ff;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #475569;
  font-size: 34rpx;
  font-weight: 700;
}

.panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.main-panel {
  margin-top: 18rpx;
}

.title-line,
.price-line,
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.dish-name {
  min-width: 0;
  flex: 1;
  color: #111827;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
}

.status {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 24rpx;
}

.danger {
  background: #fef2f2;
  color: #b91c1c;
}

.description {
  display: block;
  margin-top: 14rpx;
  color: #4b5563;
  font-size: 27rpx;
  line-height: 1.7;
}

.price-line {
  justify-content: flex-start;
  margin-top: 18rpx;
}

.price {
  color: #dc2626;
  font-size: 38rpx;
  font-weight: 800;
}

.original-price {
  color: #9ca3af;
  font-size: 24rpx;
  text-decoration: line-through;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  max-width: 180rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.info-row {
  padding: 12rpx 0;
  color: #111827;
  font-size: 27rpx;
}

.label {
  color: #6b7280;
}

.metric-grid,
.nutrition-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.nutrition-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.metric,
.nutrition {
  min-height: 112rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f9fafb;
  box-sizing: border-box;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 18rpx 32rpx 28rpx;
  border-top: 1rpx solid #e5e7eb;
  background: #ffffff;
  box-sizing: border-box;
}

.primary-action,
.ghost-action {
  min-width: 200rpx;
  height: 68rpx;
  margin: 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 68rpx;
}

.primary-action {
  border: 0;
  background: #0f766e;
  color: #ffffff;
}

.primary-action[disabled] {
  background: #d1d5db;
  color: #6b7280;
}

.ghost-action {
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  color: #4b5563;
}

.metric-value {
  display: block;
  margin-bottom: 6rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
