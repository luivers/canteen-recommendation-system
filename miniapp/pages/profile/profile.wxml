<view class="page">
  <view class="panel">
    <text class="title">我的</text>
    <text class="muted" wx:if="{{hasToken && currentUser}}">已登录：{{currentUser.username || '微信用户'}}</text>
    <text class="muted" wx:elif="{{hasToken}}">已保存登录凭证</text>
    <text class="muted" wx:else>尚未完成小程序静默登录</text>
    <button class="login-button" loading="{{loggingIn}}" bindtap="retryLogin">
      {{hasToken ? '刷新登录状态' : '静默登录'}}
    </button>
    <text class="muted" wx:if="{{loginMessage}}">{{loginMessage}}</text>
    <text class="muted">评价、个人中心详情和积分商城会在 ST-016 补齐。</text>
  </view>
</view>
