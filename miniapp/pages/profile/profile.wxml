<view class="page profile-page">
  <view class="profile-card">
    <view class="avatar">{{avatarLetter}}</view>
    <view class="profile-main">
      <text class="title">{{currentUser.username || '微信用户'}}</text>
      <text class="muted" wx:if="{{hasToken && currentUser.studentId}}">学号 {{currentUser.studentId}}</text>
      <text class="muted" wx:elif="{{hasToken}}">已保存登录凭证</text>
      <text class="muted" wx:else>尚未完成小程序静默登录</text>
      <text class="role" wx:if="{{currentUser.role}}">{{currentUser.role}}</text>
    </view>
  </view>

  <view class="points-card">
    <view>
      <text class="muted">当前积分</text>
      <text class="points">{{points}}</text>
    </view>
    <button class="refresh-button" loading="{{loadingProfile || loggingIn}}" bindtap="retryLogin">
      {{hasToken ? '刷新' : '登录'}}
    </button>
  </view>

  <text class="message" wx:if="{{loginMessage}}">{{loginMessage}}</text>

  <view class="menu-list">
    <view wx:for="{{menuItems}}" wx:key="url" class="menu-item" data-url="{{item.url}}" bindtap="openMenu">
      <view>
        <text class="menu-title">{{item.title}}</text>
        <text class="muted">{{item.desc}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
