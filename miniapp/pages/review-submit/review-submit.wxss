.review-page {
  padding-bottom: 48rpx;
}

.state {
  padding: 36rpx 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b91c1c;
}

.panel {
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.score {
  display: block;
  color: #dc2626;
  font-size: 40rpx;
  font-weight: 800;
}

.comment {
  display: block;
  margin: 12rpx 0;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.6;
}

.stars,
.mini-stars {
  display: flex;
  gap: 12rpx;
}

.star,
.mini-star {
  color: #d1d5db;
}

.star {
  font-size: 56rpx;
}

.mini-star {
  font-size: 38rpx;
}

.star.active,
.mini-star.active {
  color: #f59e0b;
}

.rating-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.label {
  color: #4b5563;
  font-size: 27rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  padding: 10rpx 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  color: #4b5563;
  font-size: 25rpx;
}

.tag.active {
  border-color: #0f766e;
  background: #ccfbf1;
  color: #115e59;
  font-weight: 700;
}

.comment-input {
  width: 100%;
  min-height: 180rpx;
  padding: 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  box-sizing: border-box;
  color: #111827;
  font-size: 27rpx;
}

.image-list {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.review-image,
.image-picker {
  width: 130rpx;
  height: 130rpx;
  border-radius: 10rpx;
}

.image-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #9ca3af;
  color: #6b7280;
  font-size: 44rpx;
}

.submit-button {
  height: 76rpx;
  border-radius: 10rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
}
