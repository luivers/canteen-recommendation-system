<view class="page">
  <view class="top-bar">
    <view>
      <text class="title">订单</text>
      <text class="muted">共 {{totalElements}} 笔订单</text>
    </view>
  </view>

  <scroll-view scroll-x class="status-strip" show-scrollbar="false">
    <view
      wx:for="{{statusTabs}}"
      wx:key="value"
      class="status-chip {{activeStatus === item.value ? 'active' : ''}}"
      data-value="{{item.value}}"
      bindtap="selectStatus"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{errorMessage && !orders.length}}" class="state">{{errorMessage}}</view>

  <view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="openOrder">
    <view class="order-head">
      <view>
        <text class="order-number">{{item.orderNumber}}</text>
        <text class="muted date">{{item.createdAtText}}</text>
      </view>
      <text class="status {{item.status}}">{{item.statusLabel}}</text>
    </view>
    <view class="item-summary">{{item.itemSummary || '暂无商品明细'}}</view>
    <view class="order-meta">
      <text>{{item.canteenName || '食堂待定'}} · {{item.windowName || '窗口待定'}}</text>
      <text>{{item.pickupTypeLabel}}</text>
    </view>
    <view class="order-foot">
      <text class="muted">应付</text>
      <text class="price">{{item.payableAmountText}}</text>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="load-more">继续加载...</view>
  <view wx:elif="{{orders.length && !hasMore}}" class="load-more">没有更多了</view>
</view>
