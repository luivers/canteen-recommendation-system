.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: #102a2b;
  color: #ffffff;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: #a7f3d0;
  font-size: 24rpx;
}

.hero-meta {
  display: block;
  margin-top: 10rpx;
  color: #d1fae5;
  font-size: 26rpx;
}

.hero-action {
  flex-shrink: 0;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 26rpx;
}

.state {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b45309;
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}

.section-more {
  color: #047857;
  font-size: 26rpx;
}

.dish-strip {
  width: 100%;
  white-space: nowrap;
}

.dish-card {
  display: inline-flex;
  flex-direction: column;
  width: 260rpx;
  min-height: 342rpx;
  margin-right: 20rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
  vertical-align: top;
}

.dish-image {
  width: 100%;
  height: 150rpx;
  border-radius: 10rpx;
  background: #eef2ff;
}

.placeholder,
.row-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #475569;
  font-size: 26rpx;
}

.dish-name {
  display: block;
  margin-top: 14rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta,
.row-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.price {
  color: #dc2626;
  font-size: 28rpx;
  font-weight: 700;
}

.one-line {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.row-image {
  flex-shrink: 0;
  width: 126rpx;
  height: 126rpx;
  border-radius: 10rpx;
  background: #fef3c7;
}

.row-main {
  min-width: 0;
  flex: 1;
}

.row-title {
  min-width: 0;
  flex: 1;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reason {
  display: inline-block;
  max-width: 100%;
  margin-top: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.health-item {
  min-height: 154rpx;
  padding: 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.health-name {
  display: block;
  margin-bottom: 8rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fit {
  display: block;
  margin-top: 10rpx;
  color: #7c3aed;
  font-size: 24rpx;
}
