<view class="page">
  <view class="top-bar">
    <text class="title">我的优惠券</text>
    <text class="muted">共 {{total}} 张</text>
  </view>

  <scroll-view scroll-x class="status-strip" show-scrollbar="false">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="status-chip {{activeUsed === item.value ? 'active' : ''}}"
      data-value="{{item.value}}"
      bindtap="selectUsed"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{errorMessage && !vouchers.length}}" class="state">{{errorMessage}}</view>

  <view wx:for="{{vouchers}}" wx:key="id" class="voucher-card {{item.used ? 'used' : ''}}">
    <view class="voucher-value">{{item.faceValueText || item.reward.faceValueText || '优惠券'}}</view>
    <view class="voucher-main">
      <text class="name">{{item.rewardName}}</text>
      <text class="muted">{{item.reward.minOrderAmountText}} · {{item.reward.validText}}</text>
      <text class="muted">{{item.statusLabel}} · {{item.usedText}}</text>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="load-more">继续加载...</view>
  <view wx:elif="{{vouchers.length && !hasMore}}" class="load-more">没有更多了</view>
</view>
