.top-bar {
  margin-bottom: 22rpx;
}

.state {
  padding: 36rpx 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  text-align: center;
}

.review-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.score {
  color: #dc2626;
  font-size: 34rpx;
  font-weight: 800;
}

.status {
  padding: 7rpx 14rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 24rpx;
}

.comment {
  display: block;
  margin: 14rpx 0 8rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.5;
}

.reply {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 1.5;
}
