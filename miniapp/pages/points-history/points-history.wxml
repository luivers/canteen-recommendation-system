<view class="page">
  <view class="top-bar">
    <text class="title">积分流水</text>
    <text class="muted">共 {{total}} 条记录</text>
  </view>

  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{errorMessage && !logs.length}}" class="state">{{errorMessage}}</view>

  <view wx:for="{{logs}}" wx:key="id" class="log-card">
    <view>
      <text class="log-title">{{item.description}}</text>
      <text class="muted">{{item.sourceLabel}} · {{item.createdAtText}}</text>
    </view>
    <text class="points {{item.isEarn ? 'earn' : 'spend'}}">{{item.pointsText}}</text>
  </view>

  <view wx:if="{{loadingMore}}" class="load-more">继续加载...</view>
  <view wx:elif="{{logs.length && !hasMore}}" class="load-more">没有更多了</view>
</view>
