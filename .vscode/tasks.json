{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "WeChat DevTools: Open Miniapp",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/wechat-devtools-cli.ps1",
        "open",
        "-Detached"
      ],
      "problemMatcher": []
    },
    {
      "label": "WeChat DevTools: Preview Miniapp",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/wechat-devtools-cli.ps1",
        "preview",
        "-Detached"
      ],
      "problemMatcher": []
    }
  ]
}
